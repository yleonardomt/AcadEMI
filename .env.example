SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
DEMO_CHECKOUT=False
ALLOWED_HOSTS=
# En Render, ALLOWED_HOSTS y SITE_URL se obtienen de RENDER_EXTERNAL_HOSTNAME
# y RENDER_EXTERNAL_URL. Para un dominio propio, define ambos manualmente.
# SITE_URL=https://tu-dominio.com
# FORCE_HTTPS=True
# BEHIND_PROXY=True

# Base de datos PostgreSQL. Crea el usuario y la base con:
#   sudo -u postgres psql -c "CREATE USER academi_user WITH PASSWORD 'tu-password';"
#   sudo -u postgres psql -c "CREATE DATABASE academi_db OWNER academi_user;"
DB_NAME=academi_db
DB_USER=academi_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# Opcional: si existe, DATABASE_URL tiene prioridad sobre DB_NAME/DB_USER/etc.
# DATABASE_URL=postgresql://usuario:clave@servidor:5432/base?sslmode=require

EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

SITE_URL=

# Opcional: clave gratuita de Gemini (https://aistudio.google.com/apikey)
# para que el chatbot responda con IA en vez de solo su base de
# conocimiento interna. Si se deja vacía, el chatbot sigue funcionando
# normalmente.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
