SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=

# Base de datos PostgreSQL. Crea el usuario y la base con:
#   sudo -u postgres psql -c "CREATE USER academi_user WITH PASSWORD 'tu-password';"
#   sudo -u postgres psql -c "CREATE DATABASE academi_db OWNER academi_user;"
DB_NAME=academi_db
DB_USER=academi_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

SITE_URL=http://127.0.0.1:8001

# Opcional: clave gratuita de Groq (https://console.groq.com/keys) para que
# el chatbot responda con IA en vez de solo su base de conocimiento interna.
# Si se deja vacía, el chatbot sigue funcionando normalmente.
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini
